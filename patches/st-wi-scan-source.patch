+/**
+ * key -> () => string。扩展注册的「纳入世界书扫描」正文源。不占注入通道。
+ *
+ * 为什么单开这条通道：extensionPrompts 上的 scan 标志效果等价（同一层 haystack，
+ * 不受 scan depth 截断、所有扫描轮次都可见），但那条路要求扩展先注册一条注入，
+ * 于是正文会连带进入注入列表与深度排序。这里只登记正文源，扩展不必借道注入。
+ */
+const extensionScanSources = new Map();
+
+/**
+ * 注册一个扫描正文源。重复注册同一个 key 即覆盖（Map 语义）。
+ * @param {string} key 唯一标识，通常用扩展名
+ * @param {() => string} getText 取正文；正文为空则整条跳过
+ * @returns {void}
+ */
+export function registerWorldInfoScanSource(key, getText) {
+    if (!key || typeof getText !== 'function') return;
+    extensionScanSources.set(String(key), getText);
+}
+
+/**
+ * 注销扫描正文源。
+ * @param {string} key 注册时用的 key
+ * @returns {void}
+ */
+export function unregisterWorldInfoScanSource(key) {
+    if (!key) return;
+    extensionScanSources.delete(String(key));
+}
