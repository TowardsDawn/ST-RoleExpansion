+// ============================================================================
+// Extension-registerable runtime prompts
+// ----------------------------------------------------------------------------
+// 让扩展能以与 worldInfoAfter / charDescription 相同的方式提供提示词正文：
+// 预设里放一张 marker: true 的卡片占位，正文由扩展每次生成时提供。
+// ============================================================================
+
+/**
+ * identifier -> () => string. 扩展注册的运行时正文提供者。
+ * 同时用于把已由运行时提供正文的 identifier 排除在通用扩展 prompt 覆盖循环之外，
+ * 避免扩展 prompt 顶掉世界书/角色卡等原生内容。
+ *
+ * @type {Map<string, () => string>}
+ */
+const runtimePromptSources = new Map();
+
+/** identifier -> 展示名。给这些卡片启用「可编辑」并显示正文来源。 */
+const extensionPromptSources = new Map();
+
+/** identifier -> { edit?: boolean, toggle?: boolean } 覆盖原生 marker 的只读限制 */
+const runtimePromptPermissions = new Map();
+
+/**
+ * 注册一个运行时正文源。
+ *
+ * @param {string} identifier 提示词 identifier
+ * @param {() => string} getContent 正文提供者，每次生成时调用；返回空串则跳过该条
+ * @param {{ name?: string, edit?: boolean, toggle?: boolean }} [options]
+ *        name   卡片「正文来源」处显示的来源名，同时使该卡片可编辑（铅笔 + Prompt List）
+ *        edit   是否允许编辑（默认跟随 name 是否存在）
+ *        toggle 是否允许用卡片上的开关启停（marker 卡片默认不允许）
+ * @returns {void}
+ */
+export function registerRuntimePromptSource(identifier, getContent, options = {}) {
+    if (!identifier || typeof getContent !== 'function') return;
+    const key = String(identifier);
+    runtimePromptSources.set(key, getContent);
+    if (options.name) {
+        extensionPromptSources.set(key, String(options.name));
+    }
+    runtimePromptPermissions.set(key, {
+        edit: options.edit ?? !!options.name,
+        toggle: !!options.toggle,
+    });
+}
+
+/**
+ * 收集所有运行时正文源的正文。返回空串的会被跳过。
+ *
+ * @returns {Array<{ identifier: string, role: string, content: string }>}
+ */
+function collectRuntimePromptSources() {
+    const out = [];
+    for (const [identifier, getContent] of runtimePromptSources) {
+        try {
+            const content = getContent();
+            if (content) out.push({ identifier, role: 'system', content });
+        } catch (error) {
+            console.error(`Runtime prompt source "${identifier}" failed`, error);
+        }
+    }
+    return out;
+}
+
+/** 供 PromptManager 查询扩展注册的正文来源 */
+export function getExtensionPromptSourceName(identifier) {
+    return extensionPromptSources.get(String(identifier)) ?? null;
+}
+
+/** 供 PromptManager 查询扩展对 marker 卡片的编辑/开关授权 */
+export function getRuntimePromptPermissions(identifier) {
+    return runtimePromptPermissions.get(String(identifier)) ?? null;
+}
+
+/**
+ * 供 PromptManager 按需构建预览：返回该 identifier 的正文提供者，未注册则返回 null。
+ * this.messages 只在构建过请求后才有数据，且内容为空的条目会被跳过，
+ * 所以扩展卡片需要这个入口来即时生成 Prompt List 预览。
+ *
+ * @param {string} identifier 提示词 identifier
+ * @returns {(() => string)|null}
+ */
+export function getRuntimePromptPreviewSource(identifier) {
+    const key = String(identifier);
+    if (!runtimePromptSources.has(key)) {
+        return null;
+    }
+    // 正文原样返回：没有内容时就是空串，交给 PromptManager 走它自己的
+    // 「No Content」显示，不在这里塞占位文案（那会被 tokenizer 计入 Tokens）。
+    return runtimePromptSources.get(key);
+}
