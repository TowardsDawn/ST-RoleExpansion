# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
# Markdown 里行尾双空格是有意义的换行
trim_trailing_whitespace = false

[*.{patch,diff}]
# 补丁必须逐字节保持原样，任何自动修剪都会让它无法 apply
trim_trailing_whitespace = false
insert_final_newline = false
